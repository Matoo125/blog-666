---
layout: layouts/base.njk
title: "Projects - Matej Vrzala"
description: "Selected portfolio projects by Matej Vrzala."
permalink: /projects/
---

<section style="margin-bottom: 2rem; max-width: 650px;">
  <h1 style="font-family: var(--font-title); font-size: 2.2rem; font-weight: 800; margin-bottom: 0.75rem;">Projects</h1>
  <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6;">A selection of things I have built, researched, and shipped.</p>
</section>

<div class="posts-grid">
  {% for project in projects %}
    <article class="post-card">
      <div class="post-card-content">
        <div class="post-meta">
          <span class="post-tags-list">
            {% for item in project.stack %}
              #{{ item }}
            {% endfor %}
          </span>
          {% if project.year %}<span class="post-date">{{ project.year }}</span>{% endif %}
        </div>
        <h2>{{ project.title }}</h2>
        <p>{{ project.description }}</p>
        {% if project.url %}
          <a href="{{ project.url }}" class="read-more" target="_blank" rel="noopener">
            {{ project.linkLabel or "View project" }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {% endif %}
      </div>
    </article>
  {% else %}
    <div style="text-align: center; color: var(--text-secondary); margin-top: 3rem;">
      <p>Projects coming soon.</p>
    </div>
  {% endfor %}
</div>
