<article class="cv">
  <header class="cv-head">
    <div class="cv-head-top">
      <h1>Matej Vrzala</h1>
      <a href="/cv.pdf" class="cv-download" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download PDF
      </a>
    </div>
    <p class="cv-summary"><strong>{{ summary.lead }}</strong> {{ summary.rest }}</p>
    <ul class="cv-contact">
      {%- for item in contact %}
      <li><a href="{{ item.url }}"{% if 'mailto:' not in item.url %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
    </ul>
  </header>

  <section class="cv-section">
    <h2>Professional Experience</h2>
    {%- for job in jobs %}
    <div class="cv-row cv-job">
      <p class="cv-key">{{ job.years }}</p>
      <div class="cv-value">
        <h3>{{ job.company }}</h3>
        <p class="cv-job-meta">{{ job.role }}, {{ job.place }}</p>
        <ul>
          {%- for point in job.points %}
          <li>{{ point }}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>
    {%- endfor %}
  </section>

  <section class="cv-section">
    <h2>Technical Skills</h2>
    <div class="cv-row">
      <p class="cv-key">Main stack</p>
      <ul class="cv-value cv-stack">
        {%- for item in mainStack %}
        <li><strong>{{ item.name }}</strong>{% if item.with %} <span>{{ item.with }}</span>{% endif %}</li>
        {%- endfor %}
      </ul>
    </div>
    <div class="cv-row">
      <p class="cv-key">Also</p>
      <p class="cv-value">{{ otherTools }}</p>
    </div>
  </section>

  <section class="cv-section">
    <h2>Additional Projects &amp; Interests</h2>
    <div class="cv-row">
      <ul class="cv-value">
        {%- for item in sideProjects %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <h2>Additional Experience &amp; Education</h2>
    <div class="cv-row">
      <ul class="cv-value">
        {%- for item in additional %}
        <li>{{ item | safe }}</li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <h2>Languages</h2>
    {%- for item in languages %}
    <div class="cv-row cv-row-tight">
      <p class="cv-key">{{ item.name }}</p>
      <p class="cv-value">{{ item.level }}</p>
    </div>
    {%- endfor %}
  </section>
</article>
