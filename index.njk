---
layout: layouts/base.njk
title: "Matej Vrzala - Personal Website & Blog"
description: "Thank you for visiting my corner of the web. I'm a software developer, aspiring effective altruist, and entrepreneur. My interests are rooted in sciences, education, and utilitarian ethics."
---

<style>
  .typing-cursor {
    display: inline-block;
    width: 3px;
    background-color: var(--text-primary);
    margin-left: 2px;
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<div class="hero">
  <div class="hero-content">
    <h1><span id="typewriter"></span><span class="typing-cursor">&nbsp;</span></h1>
    <p>Entrepreneurial software developer with security mindset and systems programming ambitions. I am currently looking for software developer roles.</p>
  </div>
  <img src="/assets/hero.jpg" alt="Matej Vrzala" class="hero-image">
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const words = ["Hello", "Ahoj", "Hallo", "Szia", "Cześć", "Привіт", "Hola", "Bonjour"];
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const typewriterElement = document.getElementById("typewriter");
    
    function typeEffect() {
      const currentWord = words[wordIndex];
      
      if (isDeleting) {
        typewriterElement.textContent = currentWord.substring(0, charIndex - 1);
        charIndex--;
      } else {
        typewriterElement.textContent = currentWord.substring(0, charIndex + 1);
        charIndex++;
      }
      
      let typeSpeed = isDeleting ? 50 : 100;
      
      if (!isDeleting && charIndex === currentWord.length) {
        typeSpeed = 2000; // Pause at end of word
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        typeSpeed = 500; // Pause before typing next word
      }
      
      setTimeout(typeEffect, typeSpeed);
    }
    
    // Start typing effect
    setTimeout(typeEffect, 500);
  });
</script>

<section id="about" style="margin-bottom: 3rem; font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; max-width: 650px;">
  <p>Thank you for visiting my corner of the web. My interests are rooted in modern sciences, and effective altruism. I believe in animal sentience, as well as human flourishing. <a href="mailto:matej@hireme.sk" class='highlighted'>Get in touch!</a> :)</p>
</section>

{% for project in projects %}
  {% if project.spotlight %}
    <section class="spotlight" aria-labelledby="spotlight-{{ project.slug }}">
      <a href="{{ project.links[0].url }}" target="_blank" rel="noopener" class="spotlight-media">
        <img src="{{ project.image }}" alt="Screenshot of {{ project.title }}" width="1200" height="750">
      </a>
      <div class="spotlight-body">
        <span class="spotlight-label">Currently building</span>
        <h2 id="spotlight-{{ project.slug }}">{{ project.title }}</h2>
        {% if project.tagline %}<p class="spotlight-tagline">{{ project.tagline }}</p>{% endif %}
        <ul class="spotlight-points">
          {% for point in project.highlights %}
            <li>{{ point }}</li>
          {% endfor %}
        </ul>
        <div class="spotlight-actions">
          {% for link in project.links %}
            <a href="{{ link.url }}" class="{% if loop.first %}spotlight-button{% else %}read-more{% endif %}" target="_blank" rel="noopener">{{ link.label }}{% if loop.first %} &rarr;{% endif %}</a>
          {% endfor %}
          <a href="/projects/{{ project.slug }}/" class="read-more">About the project</a>
        </div>
      </div>
    </section>
  {% endif %}
{% endfor %}

<h2 id="projects" style="font-family: var(--font-title); font-size: 1.6rem; font-weight: 700; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-top: 3rem; margin-bottom: 1.5rem;">Featured Projects</h2>

<div class="card-grid">
  {% for project in projects %}
    {% if project.featured and not project.spotlight %}
      {% include "partials/project-card.njk" %}
    {% endif %}
  {% endfor %}
</div>

<p style="margin-top: 1.5rem;"><a href="/projects/" class="read-more">See all projects &rarr;</a></p>

<h2 id="community" class="projects-heading">Community</h2>

<div class="card-grid community-grid">
  {% for project in projects %}
    {% if project.category == "community" %}
      {% include "partials/project-card.njk" %}
    {% endif %}
  {% endfor %}
</div>

<h2 id="writings" class="projects-heading">Writings</h2>

<ul class="writings-list">
  {% for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="post-date">{{ post.date | postDate }}</span>
    </li>
  {% endfor %}
</ul>
