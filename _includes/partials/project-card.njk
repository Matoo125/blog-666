<article class="post-card">
  {% if project.image %}
    <img src="{{ project.image }}" alt="Screenshot of {{ project.title }}" class="project-image" loading="lazy">
  {% endif %}
  <div class="post-card-content">
    <div class="post-meta">
      <span class="post-tags-list">
        {% for item in project.stack %}
          #{{ item }}
        {% endfor %}
      </span>
      {% if project.year %}<span class="post-date">{{ project.year }}</span>{% endif %}
    </div>
    <h2><a href="/projects/{{ project.slug }}/">{{ project.title }}</a></h2>
    <p>{{ project.description }}</p>
    {% for link in project.links %}
      <a href="{{ link.url }}" class="read-more" target="_blank" rel="noopener">
        {{ link.label }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    {% endfor %}
  </div>
</article>
